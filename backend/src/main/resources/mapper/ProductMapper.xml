<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.crm.mapper.ProductMapper">
    <resultMap id="product" type="com.demo.crm.entity.Product" autoMapping="true">
        <id column="id" property="id"/>
        <result column="attributes" property="attributes" typeHandler="com.demo.crm.config.JsonNodeTypeHandler"/>
    </resultMap>

    <select id="findByCategory" resultMap="product">SELECT * FROM crm_product WHERE category_id=#{categoryId}</select>
</mapper>
